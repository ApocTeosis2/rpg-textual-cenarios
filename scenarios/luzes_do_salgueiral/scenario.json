  "locations": {
    "Estalagem da Raposa": {
      "name": "Estalagem da Raposa",
      "description": "Uma estalagem antiga e acolhedora. A Iara parece preocupada com as luzes que surgem perto da ponte.",
      "actions": [
        {
          "id": "talk",
          "label": "Conversar com a Iara",
          "time_cost": 10,
          "effects": [
            {
              "op": "if",
              "when": [
                {
                  "field": "rumor",
                  "op": "eq",
                  "value": false
                }
              ],
              "then": [
                {
                  "op": "set",
                  "field": "rumor",
                  "value": true
                },
                {
                  "op": "log",
                  "text": "A Iara conta: luzes azuladas aparecem sobre a ponte depois da meia-noite. Alguns moradores acreditam que sejam fantasmas."
                }
              ],
              "else": [
                {
                  "op": "log",
                  "text": "A Iara já contou tudo o que sabia."
                }
              ]
            }
          ]
        },
        {
          "id": "investigate",
          "label": "Investigar o salão",
          "time_cost": 20,
          "effects": [
            {
              "op": "if",
              "when": [
                {
                  "field": "searched",
                  "op": "eq",
                  "value": false
                }
              ],
              "then": [
                {
                  "op": "set",
                  "field": "searched",
                  "value": true
                },
                {
                  "op": "roll",
                  "sides": 6,
                  "branches": [
                    {
                      "min": 4,
                      "effects": [
                        {
                          "op": "add",
                          "field": "coins",
                          "value": 3
                        },
                        {
                          "op": "log",
                          "text": "Você encontra três moedas esquecidas sob uma mesa."
                        }
                      ]
                    },
                    {
                      "max": 3,
                      "effects": [
                        {
                          "op": "log",
                          "text": "Você procura no salão, mas não encontra nada."
                        }
                      ]
                    }
                  ]
                }
              ],
              "else": [
                {
                  "op": "log",
                  "text": "Você já examinou o salão."
                }
              ]
            }
          ]
        },
        {
          "id": "rest",
          "label": "Descansar (1 hora)",
          "time_cost": 60,
          "effects": [
            {
              "op": "add_clamped",
              "field": "energy",
              "value": 1,
              "min": 0,
              "max": 5
            },
            {
              "op": "log",
              "text": "Você descansa e recupera um ponto de energia."
            }
          ]
        },
        {
          "id": "leave",
          "label": "Sair para o Largo de Pedra Clara",
          "time_cost": 5,
          "effects": [
            {
              "op": "move",
              "location": "Largo de Pedra Clara"
            },
            {
              "op": "log",
              "text": "Você segue para o Largo de Pedra Clara."
            }
          ]
        }
      ]
    },
