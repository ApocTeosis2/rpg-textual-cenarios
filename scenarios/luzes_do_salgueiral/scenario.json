{
  "schema_version": 2,
  "scenario_id": "luzes_do_salgueiral",
  "title": "As Luzes da Ponte do Salgueiro",
  "summary": "A mesma investigação, com novos nomes e cenário: uma estalagem, um viajante perdido e uma ponte iluminada.",
  "start_location": "Estalagem da Raposa",
  "start_text": "Você chega à estalagem numa manhã tranquila.",
  "initial_state": {
    "minute": 600,
    "energy": 4,
    "coins": 5,
    "rumor": false,
    "searched": false,
    "square_searched": false,
    "bridge_done": false,
    "forest_clue": false,
    "forest_searched": false,
    "chapel_clue": false,
    "chapel_searched": false
  },
  "stats": [
    {
      "field": "minute",
      "label": "Hora",
      "format": "clock"
    },
    {
      "field": "energy",
      "label": "Energia",
      "format": "fraction",
      "max": 5
    },
    {
      "field": "coins",
      "label": "Moedas"
    }
