{
  "schema_version": 2,
  "scenario_id": "ponte_velha",
  "title": "A Ponte Velha: Segredos na Neblina",
  "summary": "Uma aventura de investigação sobre luzes, uma ponte antiga e um viajante desaparecido.",
  "start_location": "Hospedaria do Corvo",
  "start_text": "Você chega à hospedaria numa manhã tranquila.",
  "initial_state": {
    "minute": 600,
    "energy": 4,
    "coins": 5,
    "rumor": false,
    "searched": false,
    "square_searched": false,
    "bridge_done": false,
    "forest_clue": false,
    "forest_searched": false,
    "chapel_clue": false,
    "chapel_searched": false
  },
  "stats": [
    {
      "field": "minute",
      "label": "Hora",
      "format": "clock"
    },
    {
      "field": "energy",
      "label": "Energia",
      "format": "fraction",
      "max": 5
    },
    {
      "field": "coins",
      "label": "Moedas"
    }
  ],
  "locations": {
    "Hospedaria do Corvo": {
      "name": "Hospedaria do Corvo",
      "description": "Uma hospedaria antiga e acolhedora. A atendente parece preocupada com as luzes que surgem perto da ponte.",
      "actions": [
        {
          "id": "talk",
          "label": "Conversar com a atendente",
          "time_cost": 10,
          "effects": [
            {
              "op": "if",
              "when": [
                {
                  "field": "rumor",
                  "op": "eq",
                  "value": false
                }
              ],
              "then": [
                {
                  "op": "set",
                  "field": "rumor",
                  "value": true
                },
                {
                  "op": "log",
                  "text": "A atendente conta: luzes azuladas aparecem sobre a ponte depois da meia-noite. Alguns moradores acreditam que sejam fantasmas."
                }
              ],
              "else": [
                {
                  "op": "log",
                  "text": "A atendente já contou tudo o que sabia."
                }
              ]
            }
          ]
        },
        {
          "id": "investigate",
          "label": "Investigar o salão",
          "time_cost": 20,
          "effects": [
            {
              "op": "if",
              "when": [
                {
                  "field": "searched",
                  "op": "eq",
                  "value": false
                }
              ],
              "then": [
                {
                  "op": "set",
                  "field": "searched",
                  "value": true
                },
                {
                  "op": "roll",
                  "sides": 6,
                  "branches": [
                    {
                      "min": 4,
                      "effects": [
                        {
                          "op": "add",
                          "field": "coins",
                          "value": 3
                        },
                        {
                          "op": "log",
                          "text": "Você encontra três moedas esquecidas sob uma mesa."
                        }
                      ]
                    },
                    {
                      "max": 3,
                      "effects": [
                        {
                          "op": "log",
                          "text": "Você procura no salão, mas não encontra nada."
                        }
                      ]
                    }
                  ]
                }
              ],
              "else": [
                {
                  "op": "log",
                  "text": "Você já examinou o salão."
                }
              ]
            }
          ]
        },
        {
          "id": "rest",
          "label": "Descansar (1 hora)",
          "time_cost": 60,
          "effects": [
            {
              "op": "add_clamped",
              "field": "energy",
              "value": 1,
              "min": 0,
              "max": 5
            },
            {
              "op": "log",
              "text": "Você descansa e recupera um ponto de energia."
            }
          ]
        },
        {
          "id": "leave",
          "label": "Sair para a praça",
          "time_cost": 5,
          "effects": [
            {
              "op": "move",
              "location": "Praça da vila"
            },
            {
              "op": "log",
              "text": "Você segue para a praça da vila."
            }
          ]
        }
      ]
    },
